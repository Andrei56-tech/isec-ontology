    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Threat"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "реализуется через"
      },
      {
        "@language": "en",
        "@value": "realized by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Attack"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Threat",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Потенциальный источник нежелательного воздействия на ресурс. В отличие от Attack — абстрактная возможность, а не конкретное реализованное событие."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Угроза"
      },
      {
        "@language": "en",
        "@value": "Threat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "ru",
        "@value": "опасность"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "MDISOnt — Meriah et al., 2025"
      },
      {
        "@value": "OntoSecAI — Ullah et al., 2025"
      },
      {
        "@value": "UCO — Syed et al., 2016"
      },
      {
        "@value": "SEPSES — Kiesling et al., 2019"
      },
      {
        "@value": "Лукашевич и др., 2018 (иерархия «опасность, угроза»)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#indicatesActor",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
