        "@value": "Например: технический / процессный / организационный уровень декомпозиции — по моделям объектов энергетики (Массель, Ворожцова, 2020)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Asset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "уровень критичности"
      },
      {
        "@language": "en",
        "@value": "criticality level"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "Массель, Ворожцова, 2020 (многоуровневая декомпозиция объектов)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#threatenedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
