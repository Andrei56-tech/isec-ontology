    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Protect"
      },
      {
        "@language": "ru",
        "@value": "Защита"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Risk",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Оценка потенциального ущерба, возникающего из сочетания угрозы, уязвимости и их воздействия на конкретный ресурс."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Риск"
      },
      {
        "@language": "en",
        "@value": "Risk"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#designDecision": [
      {
        "@language": "ru",
        "@value": "Риск выделен в самостоятельный класс, а не задан атрибутом угрозы или уязвимости: одна и та же уязвимость создает разный риск для разных ресурсов. Три связи (arisesFromThreat, arisesFromVulnerability, concernsAsset) представляют эту трехместную зависимость и позволяют выполнить запрос «риски для ресурса X». В источниках явная оценка риска есть только в OntoSecAI."
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "OntoSecAI — Ullah et al., 2025 (оценка риска на основе CVSS)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#CSFFunction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Одна из шести функций рамочного документа NIST Cybersecurity Framework 2.0 (Govern, Identify, Protect, Detect, Respond, Recover), которую поддерживает контрмера."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Функция NIST CSF 2.0"
      },
      {
        "@language": "en",
        "@value": "CSF Function"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "NIST CSF 2.0 — NIST, 2024; требование «полнота жизненного цикла»"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#hasImpactLevel",
