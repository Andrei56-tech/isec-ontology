  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#hasVulnerability",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "«уязвимость присуща ресурсу» — типовая связь концептуального ядра."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Asset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "имеет уязвимость"
      },
      {
        "@language": "en",
        "@value": "has vulnerability"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Vulnerability"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#vulnerabilityOfAsset"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "типовые связи концептуального ядра (Gacitua, Diéguez-Rebolledo, 2026)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#supportsFunction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Связывает контрмеру с функцией NIST CSF 2.0, которую она обеспечивает; используется для запросов покрытия жизненного цикла."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "поддерживает функцию"
      },
      {
        "@language": "en",
        "@value": "supports function"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#CSFFunction"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "требование «полнота жизненного цикла»"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#mandates",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "«нормативное требование предписывает контрмеру» — типовая связь концептуального ядра."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#NormativeRequirement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "предписывает"
      },
      {
        "@language": "en",
        "@value": "mandates"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#mandatedBy"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "типовые связи концептуального ядра (Gacitua, Diéguez-Rebolledo, 2026)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Attack",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Конкретное действие или событие, реализующее угрозу через эксплуатацию одной или нескольких уязвимостей ресурса."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Атака"
      },
      {
        "@language": "en",
        "@value": "Attack"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#designDecision": [
      {
        "@language": "ru",
        "@value": "Threat и Attack разделены на два класса, связанных свойством isec:realizes (Attack realizes Threat), а не объединены в один класс и не связаны отношением subClassOf. Источники расходятся: MDISOnt/UCO трактуют их как разные сущности, OntoSecAI по сути сливает угрозу и атаку в единую оценку риска. Разделение с явной связью 'реализует' сохраняет различимость абстрактной возможности (Threat) и конкретного события (Attack)."
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "MDISOnt — Meriah et al., 2025"
      },
      {
        "@value": "UCO — Syed et al., 2016"
      },
      {
        "@value": "SEPSES — Kiesling et al., 2019"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#hasExternalId",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Идентификатор во внешней базе знаний (например, значение вида CVE-2024-XXXXX, CWE-XXX, CAPEC-XXX, T1059 для ATT&CK). Домен — объединение Vulnerability, Weakness, AttackPattern."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "внешний идентификатор"
      },
      {
        "@language": "en",
        "@value": "external identifier"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#concernsAsset",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Risk"
      }
    ],
