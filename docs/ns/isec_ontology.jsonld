        "@language": "ru",
        "@value": "указывает на злоумышленника"
      },
      {
        "@language": "en",
        "@value": "indicates actor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#ThreatActor"
