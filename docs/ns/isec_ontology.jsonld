  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Asset",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Защищаемый ресурс: информационный, программный, аппаратный или организационный объект, обладающий ценностью и потенциально уязвимый к угрозам."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Ресурс"
      },
      {
        "@language": "en",
        "@value": "Asset"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@language": "ru",
        "@value": "актив"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "MDISOnt — Meriah et al., 2025"
      },
      {
        "@value": "OntoSecAI — Ullah et al., 2025"
      },
      {
        "@value": "UCO — Syed et al., 2016"
      },
      {
        "@value": "SEPSES — Kiesling et al., 2019"
      },
      {
        "@value": "Массель, Ворожцова, 2020 (онтологические модели объектов энергетики)"
      },
      {
        "@value": "концептуальное ядро корпуса из 93 онтологий (Gacitua, Diéguez-Rebolledo, 2026)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#KnowledgeBase",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Внешний каталог или база знаний, с которой связываются уязвимости, слабости и шаблоны атак онтологии (например, CVE, CWE, CAPEC, MITRE ATT&CK, БДУ ФСТЭК)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Внешняя база знаний"
      },
      {
        "@language": "en",
        "@value": "External Knowledge Base"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "UCO — Syed et al., 2016"
      },
      {
        "@value": "SEPSES — Kiesling et al., 2019"
      },
      {
        "@value": "требование совместимости с внешними базами знаний"
      }
    ]
  },
  {
