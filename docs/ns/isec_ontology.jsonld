  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#ResponseAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Контрмера, относящаяся к пост-инцидентной фазе (реагирование и восстановление). Выделена отдельным подклассом намеренно: обзор [раздел 3.2, 5.4] показал, что функции Respond и Recover NIST CSF 2.0 наименее обеспечены онтологической поддержкой; явное выделение подкласса делает этот участок жизненного цикла адресуемым в графе знаний."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "Действие реагирования"
      },
      {
        "@language": "en",
        "@value": "Response Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "анализ покрытия функций NIST CSF 2.0 в корпусе (Gacitua, Diéguez-Rebolledo, 2026)"
      }
    ]
  },
  {
