  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@language": "ru",
        "@value": "Ципорин П.И. Онтологии информационной безопасности: состояние исследований и консолидированная модель для контура GraphRAG (в печати)."
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-08-27"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@language": "ru",
        "@value": "Ципорин П.И."
      },
      {
        "@language": "en",
        "@value": "Tsiporin P.I."
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "ru",
        "@value": "Онтология предметной области информационной безопасности, построенная обобщением онтологических разработок и нормативных рамок, рассмотренных в обзоре. Предназначена для использования в качестве схемы графа знаний о защищаемой системе в контуре GraphRAG для анализа защищенности."
      },
      {
        "@language": "en",
        "@value": "A domain ontology of information security consolidated from published security ontologies and frameworks. Intended as the schema of a knowledge graph of a protected system in a GraphRAG pipeline for security posture analysis."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-30"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://doi.org/10.3390/app16126185"
      },
      {
        "@id": "https://doi.org/10.1007/s10115-024-02308-y"
      },
      {
        "@id": "https://doi.org/10.1371/journal.pone.0337806"
      },
      {
        "@id": "https://doi.org/10.1007/978-3-030-30796-7_13"
      },
      {
        "@id": "https://doi.org/10.18287/2223-9537-2020-10-3-327-337"
      },
      {
        "@id": "https://doi.org/10.18287/2223-9537-2018-8-1-74-95"
      },
      {
        "@id": "https://doi.org/10.6028/NIST.CSWP.29"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "ru",
        "@value": "Консолидированная онтология информационной безопасности"
      },
      {
        "@language": "en",
        "@value": "Consolidated Information Security Ontology"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "isec"
      }
    ],
