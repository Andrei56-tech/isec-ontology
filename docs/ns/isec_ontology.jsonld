      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#partOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#TransitiveProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ru",
        "@value": "Отношение часть-целое между ресурсами; по типологии тезауруса РуТез — второй тип отношений, обладающий транзитивностью при условии жёсткой связи части с целым."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Asset"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ru",
        "@value": "часть"
      },
      {
        "@language": "en",
        "@value": "part of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Asset"
      }
    ],
    "https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom": [
      {
        "@value": "Лукашевич и др., 2018 (отношение «часть — целое»)"
      }
    ]
  },
  {
    "@id": "https://andrei56-tech.github.io/isec-ontology/ns#instantiatesPattern",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://andrei56-tech.github.io/isec-ontology/ns#Attack"
      }
