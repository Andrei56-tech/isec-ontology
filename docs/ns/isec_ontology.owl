<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:isec="https://andrei56-tech.github.io/isec-ontology/ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:vann="http://purl.org/vocab/vann/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <owl:DatatypeProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#hasExternalId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ru">внешний идентификатор</rdfs:label>
    <rdfs:label xml:lang="en">external identifier</rdfs:label>
    <rdfs:comment xml:lang="ru">Идентификатор во внешней базе знаний (например, значение вида CVE-2024-XXXXX, CWE-XXX, CAPEC-XXX, T1059 для ATT&amp;CK). Домен — объединение Vulnerability, Weakness, AttackPattern.</rdfs:comment>
  </owl:DatatypeProperty>
  <isec:KnowledgeBase rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#CAPEC">
    <rdfs:label xml:lang="en">CAPEC</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://capec.mitre.org/"/>
  </isec:KnowledgeBase>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#classifiedAsWeakness">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Vulnerability"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Weakness"/>
    <rdfs:label xml:lang="ru">классифицирована как слабость</rdfs:label>
    <rdfs:label xml:lang="en">classified as weakness</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#mandates">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#NormativeRequirement"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#mandatedBy">
        <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
        <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#NormativeRequirement"/>
        <rdfs:label xml:lang="ru">предписана</rdfs:label>
        <rdfs:label xml:lang="en">mandated by</rdfs:label>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:label xml:lang="ru">предписывает</rdfs:label>
    <rdfs:label xml:lang="en">mandates</rdfs:label>
    <rdfs:comment xml:lang="ru">«нормативное требование предписывает контрмеру» — типовая связь концептуального ядра.</rdfs:comment>
    <isec:sourcedFrom>типовые связи концептуального ядра (Gacitua, Diéguez-Rebolledo, 2026)</isec:sourcedFrom>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#hasVulnerability">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Vulnerability"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#vulnerabilityOfAsset">
        <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Vulnerability"/>
        <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
        <rdfs:label xml:lang="ru">уязвимость ресурса</rdfs:label>
        <rdfs:label xml:lang="en">vulnerability of asset</rdfs:label>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:label xml:lang="ru">имеет уязвимость</rdfs:label>
    <rdfs:label xml:lang="en">has vulnerability</rdfs:label>
    <rdfs:comment xml:lang="ru">«уязвимость присуща ресурсу» — типовая связь концептуального ядра.</rdfs:comment>
    <isec:sourcedFrom>типовые связи концептуального ядра (Gacitua, Diéguez-Rebolledo, 2026)</isec:sourcedFrom>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#protects">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#protectedBy">
        <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
        <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
        <rdfs:label xml:lang="ru">защищён посредством</rdfs:label>
        <rdfs:label xml:lang="en">protected by</rdfs:label>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:label xml:lang="ru">защищает</rdfs:label>
    <rdfs:label xml:lang="en">protects</rdfs:label>
  </owl:ObjectProperty>
  <isec:KnowledgeBase rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#BDU_FSTEC">
    <rdfs:label xml:lang="ru">БДУ ФСТЭК России</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://bdu.fstec.ru/"/>
    <isec:sourcedFrom>БДУ ФСТЭК России</isec:sourcedFrom>
  </isec:KnowledgeBase>
  <owl:AnnotationProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#designDecision">
    <rdfs:label xml:lang="ru">решение о разрешении неоднозначности</rdfs:label>
    <rdfs:label xml:lang="en">disambiguation decision</rdfs:label>
    <rdfs:comment xml:lang="ru">Фиксирует, как была разрешена содержательная неоднозначность между источниками при построении онтологии, и почему.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#mitigates">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Threat"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#mitigatedBy">
        <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Threat"/>
        <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
        <rdfs:label xml:lang="ru">нейтрализуется</rdfs:label>
        <rdfs:label xml:lang="en">mitigated by</rdfs:label>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:label xml:lang="ru">нейтрализует</rdfs:label>
    <rdfs:label xml:lang="en">mitigates</rdfs:label>
    <rdfs:comment xml:lang="ru">«контрмера нейтрализует угрозу» — типовая связь концептуального ядра.</rdfs:comment>
    <isec:sourcedFrom>типовые связи концептуального ядра (Gacitua, Diéguez-Rebolledo, 2026)</isec:sourcedFrom>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#hasLikelihood">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Risk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ru">вероятность</rdfs:label>
    <rdfs:label xml:lang="en">likelihood</rdfs:label>
    <rdfs:comment xml:lang="ru">Ожидаемые значения: низкая/средняя/высокая (или числовая шкала — определяется при заполнении графа).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#hasImpactLevel">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Risk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ru">уровень ущерба</rdfs:label>
    <rdfs:label xml:lang="en">impact level</rdfs:label>
  </owl:DatatypeProperty>
  <isec:Standard rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#ISO_IEC_27000">
    <rdfs:label xml:lang="en">ISO/IEC 27000</rdfs:label>
    <isec:sourcedFrom>ISO/IEC 27000:2018</isec:sourcedFrom>
  </isec:Standard>
  <owl:DatatypeProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#hasCriticalityLevel">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="ru">уровень критичности</rdfs:label>
    <rdfs:label xml:lang="en">criticality level</rdfs:label>
    <rdfs:comment xml:lang="ru">Например: технический / процессный / организационный уровень декомпозиции — по моделям объектов энергетики (Массель, Ворожцова, 2020).</rdfs:comment>
    <isec:sourcedFrom>Массель, Ворожцова, 2020 (многоуровневая декомпозиция объектов)</isec:sourcedFrom>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#indicatesAttack">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Indicator"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Attack"/>
    <rdfs:label xml:lang="ru">указывает на атаку</rdfs:label>
    <rdfs:label xml:lang="en">indicates attack</rdfs:label>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://andrei56-tech.github.io/isec-ontology/ns">
    <owl:versionIRI rdf:resource="https://andrei56-tech.github.io/isec-ontology/1.0.0/ns"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dcterms:title xml:lang="ru">Консолидированная онтология информационной безопасности</dcterms:title>
    <dcterms:title xml:lang="en">Consolidated Information Security Ontology</dcterms:title>
    <dcterms:description xml:lang="ru">Онтология предметной области информационной безопасности, построенная обобщением онтологических разработок и нормативных рамок, рассмотренных в обзоре. Предназначена для использования в качестве схемы графа знаний о защищаемой системе в контуре GraphRAG для анализа защищенности.</dcterms:description>
    <dcterms:description xml:lang="en">A domain ontology of information security consolidated from published security ontologies and frameworks. Intended as the schema of a knowledge graph of a protected system in a GraphRAG pipeline for security posture analysis.</dcterms:description>
    <dcterms:creator xml:lang="ru">Ципорин П.И.</dcterms:creator>
    <dcterms:creator xml:lang="en">Tsiporin P.I.</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</dcterms:modified>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:bibliographicCitation xml:lang="ru">Ципорин П.И. Онтологии информационной безопасности: состояние исследований и консолидированная модель для контура GraphRAG (в печати).</dcterms:bibliographicCitation>
    <dcterms:source rdf:resource="https://doi.org/10.3390/app16126185"/>
    <dcterms:source rdf:resource="https://doi.org/10.1007/s10115-024-02308-y"/>
    <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0337806"/>
    <dcterms:source rdf:resource="https://doi.org/10.1007/978-3-030-30796-7_13"/>
    <dcterms:source rdf:resource="https://doi.org/10.18287/2223-9537-2020-10-3-327-337"/>
    <dcterms:source rdf:resource="https://doi.org/10.18287/2223-9537-2018-8-1-74-95"/>
    <dcterms:source rdf:resource="https://doi.org/10.6028/NIST.CSWP.29"/>
    <vann:preferredNamespacePrefix>isec</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://andrei56-tech.github.io/isec-ontology/ns#</vann:preferredNamespaceUri>
    <rdfs:seeAlso rdf:resource="https://github.com/Andrei56-tech/isec-ontology"/>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#arisesFromThreat">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Risk"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Threat"/>
    <rdfs:label xml:lang="ru">возникает из угрозы</rdfs:label>
    <rdfs:label xml:lang="en">arises from threat</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#partOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Asset"/>
    <rdfs:label xml:lang="ru">часть</rdfs:label>
    <rdfs:label xml:lang="en">part of</rdfs:label>
    <rdfs:comment xml:lang="ru">Отношение часть-целое между ресурсами; по типологии тезауруса РуТез — второй тип отношений, обладающий транзитивностью при условии жёсткой связи части с целым.</rdfs:comment>
    <isec:sourcedFrom>Лукашевич и др., 2018 (отношение «часть — целое»)</isec:sourcedFrom>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#ResponseAction">
    <rdfs:subClassOf rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
    <rdfs:label xml:lang="ru">Действие реагирования</rdfs:label>
    <rdfs:label xml:lang="en">Response Action</rdfs:label>
    <rdfs:comment xml:lang="ru">Контрмера, относящаяся к пост-инцидентной фазе (реагирование и восстановление). Выделена отдельным подклассом намеренно: обзор [раздел 3.2, 5.4] показал, что функции Respond и Recover NIST CSF 2.0 наименее обеспечены онтологической поддержкой; явное выделение подкласса делает этот участок жизненного цикла адресуемым в графе знаний.</rdfs:comment>
    <isec:sourcedFrom>анализ покрытия функций NIST CSF 2.0 в корпусе (Gacitua, Diéguez-Rebolledo, 2026)</isec:sourcedFrom>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#supportsFunction">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Countermeasure"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#CSFFunction"/>
    <rdfs:label xml:lang="ru">поддерживает функцию</rdfs:label>
    <rdfs:label xml:lang="en">supports function</rdfs:label>
    <rdfs:comment xml:lang="ru">Связывает контрмеру с функцией NIST CSF 2.0, которую она обеспечивает; используется для запросов покрытия жизненного цикла.</rdfs:comment>
    <isec:sourcedFrom>требование «полнота жизненного цикла»</isec:sourcedFrom>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#indicatesActor">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Indicator"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#ThreatActor"/>
    <rdfs:label xml:lang="ru">указывает на злоумышленника</rdfs:label>
    <rdfs:label xml:lang="en">indicates actor</rdfs:label>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#sourcedFrom">
    <rdfs:label xml:lang="ru">источник обобщения</rdfs:label>
    <rdfs:label xml:lang="en">generalized from</rdfs:label>
    <rdfs:comment xml:lang="ru">Указывает источник(и), из обобщения которых введена данная конструкция (краткая библиографическая метка; полные выходные данные — в README и dcterms:source онтологии).</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://andrei56-tech.github.io/isec-ontology/ns#arisesFromVulnerability">
    <rdfs:domain rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Risk"/>
    <rdfs:range rdf:resource="https://andrei56-tech.github.io/isec-ontology/ns#Vulnerability"/>
    <rdfs:label xml:lang="ru">возникает из уязвимости</rdfs:label>
    <rdfs:label xml:lang="en">arises from vulnerability</rdfs:label>
  </owl:ObjectProperty>
